# AI Document Auditor - Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Google AI (Gemini) — Primary LLM
GOOGLE_API_KEY=your_google_api_key_here

# Required: LlamaCloud — PDF table extraction via LlamaParse
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Optional: Groq — Alternative LLM (Llama 3.3 70B, Mixtral)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenRouter — Vision model for image/chart pages
OPENROUTER_API_KEY=your_openrouter_api_key_here
